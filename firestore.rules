rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public collections: anyone can read, admin can write
    match /menuItems/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /popupEvents/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /config/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Orders hold customer PII (name, email, phone, address) and a payment
    // record, so the browser never creates or reads them directly. They are
    // created by the processPayment Cloud Function (the Admin SDK bypasses
    // these rules) and shown to customers via the getOrderConfirmation
    // function. Only the admin can read the list and update status.
    match /orders/{id} {
      allow read, update: if request.auth != null && request.auth.token.admin == true;
      allow create, delete: if false;
    }

    // Everything else: deny by default
  }
}
