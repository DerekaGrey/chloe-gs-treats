# Non-secret Square settings, read at deploy time. Every deploy is LIVE.
# Replace the location ID with the PRODUCTION one (developer.squareup.com >
# your app > Production > Locations). scripts/check-live.mjs blocks a deploy
# while REPLACE_ME remains.
#
# For local testing the emulator overrides these with functions/.env.local
# (sandbox values, git-ignored; see functions/.env.local.example).
SQUARE_ENV=production
SQUARE_LOCATION_ID=REPLACE_ME
